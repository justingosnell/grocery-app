{
  "name": "grocery-list-creator",
  "version": "1.0.0",
  "description": "A modern grocery list creator with emoji support",
  "main": "index.html",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "tailwind:dev": "tailwindcss -i ./src/input.css -o ./src/tailwind.css --watch",
    "build": "npm run tailwind:build && vite build && node scripts/inline-build-css.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tailwind:build": "tailwindcss -i ./src/input.css -o ./src/tailwind.css --minify"
  },
  "keywords": [
    "grocery",
    "list",
    "pwa",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clerk/clerk-js": "^6.25.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "vite": "^7.0.0"
  }
}
