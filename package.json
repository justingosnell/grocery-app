{
  "name": "grocery-list-creator",
  "version": "1.0.0",
  "description": "A modern grocery list creator with emoji support",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "nodemon --watch server.js server.js",
    "dev:client": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify"
  },
  "keywords": [
    "grocery",
    "list",
    "express",
    "mongodb",
    "mongoose",
    "socket.io",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.0"
  }
}